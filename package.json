{
  "name": "lghs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Leonhart's Game Hosting System",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
