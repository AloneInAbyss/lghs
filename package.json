{
  "name": "lghs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Leonhart's Game Hosting System",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
