{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (@lghs/core)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@lghs/core",
        "exec",
        "vitest",
        "run",
        "--inspect-brk",
        "--no-file-parallelism"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current Vitest file",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@lghs/core",
        "exec",
        "vitest",
        "run",
        "${relativeFile}",
        "--inspect-brk",
        "--no-file-parallelism"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug control-plane",
      "program": "${workspaceFolder}/apps/control-plane/dist/main.js",
      "cwd": "${workspaceFolder}/apps/control-plane",
      "preLaunchTask": "build-control-plane",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
