{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-control-plane",
      "type": "shell",
      "command": "pnpm --filter @lghs/control-plane run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-all",
      "type": "shell",
      "command": "pnpm -r run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    }
  ]
}
